ACTION:DISPLAY
DESCRIPTION:Zítra začínají volby – zkontrolujte si volební místnost
TRIGGER:-P1D
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Volební místnosti jsou otevřené do 22:00
TRIGGER:-PT1H
END:VALARM
END:VEVENT
